      <Parent z:Ref="i1" />
      <Id>3</Id>
      <Name>CCRs_AEB_On</Name>
      <Comment>Car-To-Car Rear standing: Approach to standing target with different velocities.
With this logical test case 'AEB Inter-Urban' systems that work at higher velocities (30-80 km/h) are tested.</Comment>
      <Enabled>true</Enabled>
      <Duration>100</Duration>
      <ConcreteTestCases>
        <d2p1:anyType z:Id="i3807" i:type="ConcreteTestCase">
          <ExecutedBy i:nil="true" />
          <IsReportLinkInvalid>true</IsReportLinkInvalid>
          <LastExecution i:nil="true" />
          <LastModification i:nil="true" />
          <ModifiedBy i:nil="true" />
          <ReportPath></ReportPath>
          <Verdict>Undefined</Verdict>
          <Anchor></Anchor>
          <Comment></Comment>
          <ConcreteFunctions>
            <d2p1:anyType z:Id="i3808" i:type="ValidationFunctionConcrete">
              <Result z:Id="i3809" i:type="ValidationFunctionResult">
                <ResultContent z:Id="i3810" i:type="NoResult">
                  <ResultContentType>NoContent</ResultContentType>
                </ResultContent>
                <Verdict>Undefined</Verdict>
              </Result>
              <ValidationFunction z:Id="i3811" i:type="EvaluationFunctionCustom">
                <Comment>Verifying, whether the normalized score of the AEB system exceeds the value 0.5. The randomly chosen value is not part of the NCAP assessment protocol (for more details see custom evaluation function).</Comment>
                <Id>1</Id>
                <Parameters z:Id="i3812">
                  <anyType z:Id="i3813" i:type="ValidationParameterCurrentSignal">
                    <Id>1</Id>
                    <Type>CurrentSignal</Type>
                    <Name>Sensors.Collision_Sensor.Collision_Sensor_1.SensorOutput.v_Collision_CoG_Vehicle_Total[m|s]{1} (Environment)</Name>
                    <LayoutName>Env_CollisionSensor</LayoutName>
