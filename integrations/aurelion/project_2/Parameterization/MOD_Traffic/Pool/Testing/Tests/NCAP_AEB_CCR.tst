                  </anyType>
                  <anyType z:Id="i1221" i:type="ValidationParameterConstant">
                    <Id>3</Id>
                    <Type>Constant</Type>
                    <Value>0.1</Value>
                  </anyType>
                </Parameters>
                <Type>Evaluation</Type>
                <Function>IsInsideBounds</Function>
              </ValidationFunction>
            </d2p1:anyType>
